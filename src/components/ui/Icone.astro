export type NomIcone = keyof typeof ICONES

interface Props {
  nom: NomIcone
  class?: string
  /** Remplissage plein (étoiles). */
  plein?: boolean
}

const { nom, class: classe, plein = false } = Astro.props
---

<svg
  class={classe}
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill={plein ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONES[nom]}
></svg>
