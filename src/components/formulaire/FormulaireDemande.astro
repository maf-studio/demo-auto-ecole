---
import Icone from '../ui/Icone.astro'
import { ETABLISSEMENT } from '../../data/etablissement.ts'
import { emettreJeton } from '../../lib/demande/anti-spam.ts'
import { configurationEnvoi } from '../../lib/demande/configuration.ts'
import { MESSAGE_MAX } from '../../lib/demande/regles.ts'
import {
  OPTIONS_FINANCEMENT,
  OPTIONS_FORMATION,
  libelleFormation,
} from '../../lib/demande/schema.ts'

/**
 * LE formulaire du site : contact, devis, financement. Une seule logique
 * (`lib/demande/`), une seule route d’envoi (`/api/demande`).
 *
 * `formation` : la formation présélectionnée (et transmise dans la demande).
 * Sur /contact, `?formation=permis-b` dans l’adresse la présélectionne aussi.
 * `variante` : `court` (pages formations), `complet` (contact), `financement`
 * (le choix du dispositif passe en premier).
 *
 * Sans service d’envoi configuré, le formulaire n’est PAS affiché : les moyens
 * directs le remplacent, avec un e-mail prérempli. Jamais d’envoi simulé. Seule
 * exception, la démonstration : le formulaire s’affiche, rien n’est envoyé, et
 * la confirmation le dit.
 */
interface Props {
  id: string
  formation?: string
  financement?: string
  variante?: 'court' | 'complet' | 'financement'
}

const { id, formation = '', financement = '', variante = 'complet' } = Astro.props
const configuration = configurationEnvoi()
const e = ETABLISSEMENT

const groupes = [
  { cle: 'code', libelle: 'Code de la route' },
  { cle: 'auto', libelle: 'Permis auto' },
  { cle: 'moto', libelle: 'Permis moto' },
  { cle: 'autre', libelle: 'Autre' },
] as const

const nomFormation = formation ? libelleFormation(formation) : null
const sujet = nomFormation ? `Demande de devis : ${nomFormation}` : 'Demande de renseignements'
const corpsMail = [
  'Bonjour,',
  '',
  nomFormation ? `Je souhaite un devis pour : ${nomFormation}.` : 'Je souhaite des renseignements sur vos formations.',
  '',
  'Nom et prénom :',
  'Téléphone :',
  '',
  'Merci.',
].join('\n')
const mailto = `mailto:${e.email}?subject=${encodeURIComponent(sujet)}&body=${encodeURIComponent(corpsMail)}`

const jeton = configuration ? emettreJeton(configuration.secret, Date.now(), 'page') : ''
const chemin = Astro.url.pathname
const champ = (nom: string) => `${id}-${nom}`
const avecFinancement = variante !== 'court'
---

{
  configuration ? (
    <div class="formulaire" data-formulaire-bloc>
      <form action="/api/demande" method="post" data-formulaire data-telephone={e.telephone.affiche} id={id}>
        <div class="formulaire__resume" data-resume tabindex="-1" hidden>
          <p>
            <strong>Votre demande n’est pas encore partie.</strong> Corrigez les champs suivants :
          </p>
          <ul data-resume-liste />
        </div>

        <p class="formulaire__obligatoire">
          Les champs marqués <span aria-hidden="true">*</span>
          <span class="visuellement-masque">d’un astérisque</span> sont obligatoires.
        </p>

        <div class="formulaire__grille">
          {variante === 'financement' && (
            <div class="champ champ--large">
              <label for={champ('financement')}>Solution de financement envisagée</label>
              <select id={champ('financement')} name="financement" aria-describedby={`${champ('financement')}-erreur`}>
                <option value="">Choisir (facultatif)</option>
                {OPTIONS_FINANCEMENT.map((o) => (
                  <option value={o.valeur} selected={o.valeur === financement}>
                    {o.libelle}
                  </option>
                ))}
              </select>
              <p class="champ__erreur" id={`${champ('financement')}-erreur`} data-erreur="financement" />
            </div>
          )}

          <div class="champ">
            <label for={champ('nom')}>
              Nom et prénom <span aria-hidden="true">*</span>
            </label>
            <input
              id={champ('nom')}
              name="nom"
              type="text"
              autocomplete="name"
              required
              maxlength="100"
              aria-describedby={`${champ('nom')}-erreur`}
            />
            <p class="champ__erreur" id={`${champ('nom')}-erreur`} data-erreur="nom" />
          </div>

          <div class="champ">
            <label for={champ('telephone')}>
              Téléphone <span aria-hidden="true">*</span>
            </label>
            <input
              id={champ('telephone')}
              name="telephone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              required
              maxlength="25"
              aria-describedby={`${champ('telephone')}-aide ${champ('telephone')}-erreur`}
            />
            <p class="champ__aide" id={`${champ('telephone')}-aide`}>Exemple : 06 12 34 56 78</p>
            <p class="champ__erreur" id={`${champ('telephone')}-erreur`} data-erreur="telephone" />
          </div>

          <div class="champ">
            <label for={champ('email')}>
              E-mail <span aria-hidden="true">*</span>
            </label>
            <input
              id={champ('email')}
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="160"
              aria-describedby={`${champ('email')}-erreur`}
            />
            <p class="champ__erreur" id={`${champ('email')}-erreur`} data-erreur="email" />
          </div>

          <div class="champ">
            <label for={champ('formation')}>
              Formation souhaitée <span aria-hidden="true">*</span>
            </label>
            <select id={champ('formation')} name="formation" required aria-describedby={`${champ('formation')}-erreur`}>
              <option value="" disabled selected={!formation}>
                Choisir une formation
              </option>
              {groupes.map((g) => (
                <optgroup label={g.libelle}>
                  {OPTIONS_FORMATION.filter((o) => o.groupe === g.cle).map((o) => (
                    <option value={o.valeur} selected={o.valeur === formation}>
                      {o.libelle}
                    </option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p class="champ__erreur" id={`${champ('formation')}-erreur`} data-erreur="formation" />
          </div>

          {variante === 'complet' && (
            <div class="champ champ--large">
              <label for={champ('financement')}>Solution de financement envisagée (facultatif)</label>
              <select id={champ('financement')} name="financement" aria-describedby={`${champ('financement')}-erreur`}>
                <option value="">Aucune pour l’instant</option>
                {OPTIONS_FINANCEMENT.map((o) => (
                  <option value={o.valeur} selected={o.valeur === financement}>
                    {o.libelle}
                  </option>
                ))}
              </select>
              <p class="champ__erreur" id={`${champ('financement')}-erreur`} data-erreur="financement" />
            </div>
          )}

          <div class="champ champ--large">
            <label for={champ('message')}>Message (facultatif)</label>
            <textarea
              id={champ('message')}
              name="message"
              rows={variante === 'court' ? 3 : 5}
              maxlength={MESSAGE_MAX}
              aria-describedby={`${champ('message')}-erreur`}
            />
            <p class="champ__erreur" id={`${champ('message')}-erreur`} data-erreur="message" />
          </div>
        </div>

        <div class="champ champ--case">
          <input
            id={champ('consentement')}
            name="consentement"
            type="checkbox"
            value="oui"
            required
            aria-describedby={`${champ('consentement')}-erreur`}
          />
          <label for={champ('consentement')}>
            J’accepte que mes données soient utilisées pour répondre à ma demande, comme l’explique la{' '}
            <a href="/confidentialite">politique de confidentialité</a>. <span aria-hidden="true">*</span>
          </label>
          <p class="champ__erreur" id={`${champ('consentement')}-erreur`} data-erreur="consentement" />
        </div>

        <div class="formulaire__piege" aria-hidden="true">
          <label>
            Laissez ce champ vide
            <input type="text" name="piege" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <input type="hidden" name="jeton" value={jeton} data-jeton />
        <input type="hidden" name="depuis" value={chemin} />
        {avecFinancement ? null : <input type="hidden" name="financement" value="" />}

        <div class="formulaire__envoi">
          <button class="bouton" type="submit" data-envoyer>
            Envoyer ma demande
            <Icone nom="fleche" />
          </button>
          <p class="formulaire__statut" role="status" aria-live="polite" data-statut />
        </div>
      </form>

      <div class="formulaire__succes" data-succes tabindex="-1" hidden>
        <span class="formulaire__succes-icone">
          <Icone nom="coche" />
        </span>
        {
          configuration.fournisseur === 'demonstration' ? (
            <div>
              <p class="formulaire__succes-titre">Demande validée (démonstration)</p>
              <p>
                Sur ce site de démonstration, rien n’est envoyé. Sur votre site, la demande arrive aussitôt dans votre
                boîte e-mail, avec les coordonnées de l’élève et la formation choisie.
              </p>
            </div>
          ) : (
            <div>
              <p class="formulaire__succes-titre">Votre demande est bien arrivée</p>
              <p>
                Merci ! Nous vous recontactons par téléphone ou par e-mail, aux horaires du bureau. Pour une question
                urgente : <a href={e.telephone.lien}>{e.telephone.affiche}</a>.
              </p>
            </div>
          )
        }
      </div>
    </div>
  ) : (
    <div class="formulaire-direct">
      <p class="formulaire-direct__texte">
        {nomFormation
          ? `Pour un devis ou un renseignement sur la formation « ${nomFormation} », contactez-nous directement :`
          : 'Pour un devis ou un renseignement, contactez-nous directement :'}
      </p>
      <div class="boutons">
        <a class="bouton" href={e.telephone.lien}>
          <Icone nom="telephone" />
          Appeler le {e.telephone.affiche}
        </a>
        <a class="bouton bouton--contour" href={mailto}>
          <Icone nom="email" />
          Écrire un e-mail
        </a>
      </div>
      <p class="formulaire-direct__note">
        L’e-mail s’ouvre dans votre messagerie, déjà rempli avec la formation choisie. Vous pouvez aussi passer au
        bureau, {e.adresse.rue}.
      </p>
    </div>
  )
}

<script>
  import '../../scripts/formulaire.ts'
</script>

<style>
  .formulaire,
  .formulaire-direct {
    position: relative;
  }

  .formulaire__obligatoire {
    margin-block-end: var(--e-5);
    font-size: var(--taille-petit);
    color: var(--texte-doux);
  }

  .formulaire__grille {
    display: grid;
    gap: var(--e-5) var(--e-5);
  }

  .champ {
    display: grid;
    gap: var(--e-2);
    align-content: start;
  }

  .champ label {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .champ label span[aria-hidden] {
    color: var(--erreur);
  }

  .champ input:not([type='checkbox']),
  .champ select,
  .champ textarea {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--bord-champ);
    border-radius: var(--rayon-s);
    background: var(--blanc);
    color: var(--encre);
    font-size: 1rem;
    transition: border-color var(--duree-courte) var(--courbe), box-shadow var(--duree-courte) var(--courbe);
  }

  .champ textarea {
    resize: vertical;
    min-height: 6rem;
  }

  .champ input:hover,
  .champ select:hover,
  .champ textarea:hover {
    border-color: var(--nuit);
  }

  .champ input:focus-visible,
  .champ select:focus-visible,
  .champ textarea:focus-visible {
    outline: none;
    border-color: var(--petrole-fonce);
    box-shadow: 0 0 0 3px rgb(37 109 133 / 0.3);
  }

  .champ [aria-invalid='true'] {
    border-color: var(--erreur);
    background: var(--erreur-voile);
  }

  .champ__aide {
    font-size: var(--taille-petit);
    color: var(--texte-doux);
  }

  .champ__erreur {
    font-size: var(--taille-petit);
    font-weight: 700;
    color: var(--erreur);
  }

  .champ__erreur:empty {
    display: none;
  }

  .champ--case {
    grid-template-columns: 1.4rem 1fr;
    column-gap: var(--e-3);
    margin-block-start: var(--e-5);
  }

  .champ--case input {
    width: 1.4rem;
    height: 1.4rem;
    margin: 0.1rem 0 0;
    accent-color: var(--petrole-fonce);
  }

  .champ--case label {
    font-weight: 500;
    font-size: 0.93rem;
  }

  .champ--case .champ__erreur {
    grid-column: 2;
  }

  .formulaire__piege {
    position: absolute;
    inset-inline-start: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .formulaire__envoi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4) var(--e-5);
    margin-block-start: var(--e-6);
  }

  .formulaire__statut {
    font-weight: 600;
  }

  .formulaire__statut[data-etat='erreur'] {
    padding: var(--e-3) var(--e-4);
    border-radius: var(--rayon-s);
    background: var(--erreur-voile);
    color: var(--erreur);
  }

  .formulaire__resume {
    margin-block-end: var(--e-5);
    padding: var(--e-4) var(--e-5);
    border-inline-start: 4px solid var(--erreur);
    border-radius: var(--rayon-s);
    background: var(--erreur-voile);
    color: var(--erreur);
  }

  .formulaire__resume ul {
    margin-block-start: var(--e-2);
    padding-inline-start: 1.2rem;
  }

  .formulaire__resume a {
    color: var(--erreur);
    font-weight: 700;
  }

  .formulaire__succes {
    display: flex;
    gap: var(--e-4);
    padding: var(--e-5);
    border-radius: var(--rayon);
    background: var(--succes-voile);
    color: var(--succes);
  }

  .formulaire__succes[hidden] {
    display: none;
  }

  .formulaire__succes-icone {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--succes);
    color: var(--blanc);
  }

  .formulaire__succes-titre {
    margin-block-end: var(--e-2);
    font-family: var(--police-titre);
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .formulaire__succes a {
    color: var(--succes);
    font-weight: 700;
  }

  .formulaire-direct__texte {
    margin-block-end: var(--e-5);
    font-weight: 600;
  }

  .formulaire-direct__note {
    margin-block-start: var(--e-4);
    font-size: var(--taille-petit);
    color: var(--texte-doux);
  }

  @media (min-width: 40rem) {
    .formulaire__grille {
      grid-template-columns: 1fr 1fr;
    }

    .champ--large {
      grid-column: 1 / -1;
    }
  }
</style>
